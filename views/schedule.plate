{{ plug: 'head', title: 'Schedule', links: [route('main') => 'Home'] }}

<div class="column">
    {{ each: $counts as $date => $count }}
        <a href="{{ route('schedule.date', date: $date) }}" class="btn {{ $colour($date) }}">
            {{ $date.' ('.$count.')' }}
        </a>
    {{ each; }}
</div>

<style>
    .btn.gray {
        background-color: gray;
    }
</style>