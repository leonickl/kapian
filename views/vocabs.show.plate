{{ plug: 'head', title: $vocab->summary(), links: [
    route('main') => 'Home',
    route('vocabs.edit', vocabId: $vocab->id) => 'Edit',
] }}

<script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3.5/dist/hanzi-writer.min.js"></script>

<div id="details">
    {{ if: $vocab->hanzi }}
        <div id="hanzis">
            {{ each: mb_str_split($vocab->hanzi) as $i => $hanzi }}
                <div id="hanzi-symbol-{{ $i }}" class="hanzi-symbol" data-hanzi="{{ $hanzi }}"></div>
            {{ each; }}
        </div>
    {{ if; }}

    {{ if: $vocab->pinyin }}
        <div id="pinyin">
            <em>{{ $vocab->pinyin }}</em>
        </div>
    {{ if; }}

    {{ if: $vocab->translation }}
        <div id="translation">{{ $vocab->translation }}</div>
    {{ if; }}

    <div id="tags" class="mt">
        {{ each: $vocab->tags() as $tag }}
            <div class="tag-chip">
                <a href="{{ route('tags.show', tagId: $tag->id) }}">{{ $tag->label }}</a>
            </div>
        {{ each; }}
    </div>
</div>

<script>
    const symbols = document.querySelectorAll('.hanzi-symbol');

    symbols.forEach(symbol => {
        const hanzi = symbol.getAttribute('data-hanzi');

        console.log(hanzi)

        const writer = HanziWriter.create(symbol.id, hanzi, {
            width: 100,
            height: 100,
            padding: 5,
            showOutline: false,
            strokeAnimationSpeed: 1.5,
            delayBetweenStrokes: 200,
            radicalColor: '#a0beff',
            strokeColor: '#4b659f',
            onLoadCharDataSuccess:
                () => symbol.addEventListener('click', () => writer.animateCharacter()),
            onLoadCharDataError:
                (err) => {
                    console.log(`No hanzi for '${hanzi}' was found.`);
                    symbol.innerHTML = hanzi
                    symbol.style.fontSize = '30px'
                    symbol.style.paddingTop = '30px'
                },
        });
    });
</script>

<style>
    #details {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    #hanzis {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
    }

    #pinyin {
        text-align: center;
    }

    #translation {
        text-align: center;
    }

    #tags {
        text-align: center;
    }

    .tag-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.1rem 0.5rem 0.1rem 0.65rem;
        border-radius: 999px;
        background: var(--primary);
        color: #fff;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .tag-chip a {
        color: #fff;
    }

    .tag-chip a:hover {
        opacity: .6;
        text-decoration: none;
    }
</style>
