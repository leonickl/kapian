{{ plug: 'head', title: $vocab->summary(), links: [
    route('main') => 'Home',
    route('vocabs.edit', vocabId: $vocab->id) => 'Edit',
] }}

<div id="details">
    {{ if: $vocab->hanzi }}
        {{ plug: 'strokes', hanzis: mb_str_split($vocab->hanzi) }}
    {{ if; }}

    {{ if: $vocab->pinyin }}
        <div id="pinyin">
            <em>{{ $vocab->pinyin }}</em>
        </div>
    {{ if; }}

    {{ if: $vocab->translation }}
        <div id="translation">{{ $vocab->translation }}</div>
    {{ if; }}

    <div id="tags" class="mt">
        {{ each: $vocab->tags() as $tag }}
            <div class="tag-chip">
                <a href="{{ route('tags.show', tagId: $tag->id) }}">{{ $tag->label }}</a>
            </div>
        {{ each; }}
    </div>

    {{ if: $vocab->cards()->count() > 0 }}
        <h2>Flashcards</h2>

        <div id="cards">
            {{ each: $vocab->cards() as $card }}
                <div>
                    <b>{{ $card->direction }}:</b>
                    {{ $card->progress()->label() }}
                </div>
            {{ each; }}
        </div>
    {{ if; }}
</div>

<style>
    #details {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    #pinyin {
        text-align: center;
    }

    #translation {
        text-align: center;
    }

    #tags {
        text-align: center;
    }

    .tag-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.1rem 0.5rem 0.1rem 0.65rem;
        border-radius: 999px;
        background: var(--primary);
        color: #fff;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .tag-chip a {
        color: #fff;
    }

    .tag-chip a:hover {
        opacity: .6;
        text-decoration: none;
    }
</style>
