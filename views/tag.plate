{{ plug: 'head', title: "#$tag->label", links: [
    route('main') => 'Home',
] }}

{{ plug: 'button',
    href: route('tags.study', tagId: $tag->id),
    label: 'Study' }}

{{ if: $tag->canShare() }}
    <div class="mb">
        <h2>Members</h2>

        <div class="people row">
            {{ each: $people as $person }}
                <form action="{{ route('tags.share', tagId: $tag->id, recipientId: $person->id) }}" method="post">
                    <input type="submit"
                        class="btn secondary {{ $tag->isSharedWith($person) ? 'glowing' : '' }}"
                        value="{{ $person->name }}" />
                </form>
            {{ each; }}
        </div>
    </div>
{{ if; }}

<div class="overflow-x-auto mt">
    <h2>Vocabs</h2>

    <table class="styled w-full quotes">
        <thead>
            <tr>
                <th>#</th>
                <th>Hanzi</th>
                <th>Pinyin</th>
                <th>Translation</th>
                <th>Tags</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            {{ each: $tag->vocabs() as $vocab }}
                <tr>
                    <td class="td-id">{{ $vocab->id }}</td>
                    <td class="td-hanzi">{{ $vocab->hanzi }}</td>
                    <td class="td-pinyin">{{ $vocab->pinyin }}</td>
                    <td class="td-translation">{{ $vocab->translation }}</td>
                    <td class="td-tags">
                        {{ each: $vocab->tags() as $tag }}
                            <span>#{{ $tag->label }}</span>
                        {{ each; }}
                    </td>
                    <td class="td-actions">
                        {{ if: $vocab->canShow() }}
                            <a href="{{ route('vocabs.show', vocabId: $vocab->id) }}">
                                {{ plug: 'icons/info' }}
                            </a>
                        {{ if; }}
                    </td>
                </tr>
            {{ each; }}
        </tbody>
    </table>
</div>

<style>
    .glowing {
        border: 3px #54d5ff solid;
    }

    .people > form {
        display: flex;
    }
</style>