{{ plug: 'head', title: "#{$tag->label()}", links: [
    route('main') => 'Home',
    route('tags.edit', tagId: $tag->id) => 'Edit',
] }}

{{ plug: 'button',
    href: route('tags.study', tagId: $tag->id),
    label: 'Study' }}

<div class="overflow-x-auto mt mb">
    <h2>Vocabs</h2>

    {{ plug: 'vocabs.list', vocabs: $tag->vocabs() }}
</div>

<div class="mt">
    <h2>Tag Settings</h2>

    {{ plug: 'button',
        href: route('tags.toggle-strokes', tagId: $tag->id),
        classes: 'secondary',
        label: $tag->strokes ? 'Disable stroke cards' : 'Enable stroke cards' }}

    {{ if: $tag->canShare() }}
        <h3 class="mt">Members:</h3>

        <div class="people row">
            {{ each: $people as $person }}
                <form action="{{ route('tags.share', tagId: $tag->id, recipientId: $person->id) }}" method="post">
                    <input type="submit"
                        class="btn secondary {{ $tag->isSharedWith($person) ? 'glowing' : '' }}"
                        value="{{ $person->name }}" />
                </form>
            {{ each; }}
        </div>
    {{ if; }}
</div>

<style>
    .glowing {
        border: 3px #54d5ff solid;
    }

    .people > form {
        display: flex;
    }
</style>