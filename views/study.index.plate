{{ plug: 'head', title: 'Study', links: [route('main') => 'Home'] }}

<div class="column">
    {{ if: $left > 0 }}
        <p>Currently, {{ $left }} cards are waiting for you.</p>
        <a href="{{ route('study.front') }}" class="btn" target="_blank">Study now</a>

        {{ plug: 'button',
            href: route('study.cancel'),
            label: 'Cancel study-queue',
            classes: 'warn' }}
    {{ else: }}
        <p>Currently, there are no cards left in the study-queue. Try to add some:</p>
        <a href="{{ route('tags') }}" class="btn">Browse Tags</a>
        <a href="{{ route('cardbox') }}" class="btn">Browse Cardbox</a>
    {{ if; }}
</div>
