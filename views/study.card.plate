{{ plug: 'head', title: "Study", subtitle: "$left left", links: [route('main') => 'Home'] }}

<div class="flashcard">
    {{ if: $card->direction === 'hanzi' }}
        <span class="hanzi">{{ $card->hanzi }}</span>
    {{ elif: $card->direction === 'pinyin' }}
        <span>{{ $card->pinyin }}</span>
    {{ elif: $card->direction === 'translation' }}
        <span>{{ $card->translation }}</span>
    {{ else: }}
        <em>unknown card direction '{{ $card->direction }}'</em>
    {{ if; }}

    {{ if: $back }}
        <hr />

        {{ if: $card->direction === 'hanzi' }}
            <span>{{ $card->pinyin }}</span>
            <span>{{ $card->translation }}</span>
        {{ elif: $card->direction === 'pinyin' }}
            <span>{{ $card->translation }}</span>
            <span class="hanzi">{{ $card->hanzi }}</span>
        {{ elif: $card->direction === 'translation' }}
            <span>{{ $card->pinyin }}</span>
            <span class="hanzi">{{ $card->hanzi }}</span>
        {{ else: }}
            <em>unknown card direction '{{ $card->direction }}'</em>
        {{ if; }}
    {{ if; }}

        {{ if: $back }}
            <div class="row between mt">

                {{ plug: 'button',
                    href: route('study.result', result: 'correct'),
                    styles: 'background-color: #209920',
                    label: 'Correct' }}

                {{ plug: 'button',
                    href: route('study.result', result: 'again'),
                    styles: 'background-color: #e69f1d',
                    label: 'Again' }}

                {{ plug: 'button',
                    href: route('study.result', result: 'wrong'),
                    styles: 'background-color: #d21111',
                    label: 'Wrong' }}

                <button id="more" class="btn secondary">
                    <div>...</div>
                </button>
            </div>
        {{ else: }}
            <div class="row between mt">
                <a href="{{ route('study.back') }}" class="btn">Check</a>

                {{ plug: 'button',
                    href: route('study.skip'),
                    classes: 'secondary',
                    label: 'Skip' }}

                {{ plug: 'button',
                    href: route('study.bury'),
                    classes: 'secondary',
                    label: 'Bury' }}
            </div>
        {{ if; }}
</div>

{{ if: $back }}
    <div id="btns" class="row between mt hidden">
        {{ plug: 'button',
            href: route('study.bury'),
            classes: 'secondary',
            label: 'Bury' }}

        <a href="{{ route('vocabs.edit', vocabId: $card->vocab()->id) }}"
            target="_blank" class="btn secondary">Edit Vocab</a>
    </div>
{{ if; }}

<script>
    const more = document.querySelector('#more')
    const btns = document.querySelector('#btns')

    more.addEventListener('click', () => {
        btns.classList.toggle('hidden')
    })
</script>

<style>
    body {
        height: 90vh;
    }

    main {
        height: 100%;
        width: min(100%, 500px);
    }

    .flashcard {
        background-color: #ffe79a;
        color: navy;

        width: min(100%, 400px);
        min-height: 250px;

        padding: 1rem;
        border-radius: 1rem;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        position: absolute;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        align-items: center;
    }

    .flashcard hr {
        width: 70%;
        margin-block: 1rem;
        border-color: navy;
        opacity: .3;
    }

    .flashcard .hanzi {
        font-size: 30px;
    }

    .hidden {
        display: none;
    }

    #more {
        width: 20px;
        display: flex;
        flex-direction: row;
        justify-content: center;
    }

    #more > div {
        rotate: 90deg;
        translate: 1.5px 0;
    }

    #btns {
        position: fixed;
        bottom: 1rem;
        left: 50%;
        translate: -50% 0;
    }
</style>
