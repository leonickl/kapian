<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" href="/icon.ico" sizes="any" />

    <link rel="manifest" href="/manifest.json" />

    {{ each: config('css', []) as $file }}
        <link rel="stylesheet" href="{{ route('css', file: $file) }}" />
    {{ each; }}

    {{ each: config('js', []) as $file }}
        <script src="{{ route('js', file: $file) }}"></script>
    {{ each; }}

    <title>{{ config('title') }}</title>
</head>

<body>
    <div id="open-fullscreen">
        {{ plug: 'icons/fullscreen' }}
    </div>

    <main>
        {{ each: notifications() ?? [] as $notification }}
            <div class="notification {{ $notification->type }}">
                <p class="m-0 p-0">{{ $notification->content }}</p>
            </div>
        {{ each; }}

        {{ % $slot }}
    </main>

    <script>
        function fullscreen(elem) {
            if (elem.requestFullscreen) {
                return elem.requestFullscreen()
            }
            
            if (elem.webkitRequestFullscreen) {
                return elem.webkitRequestFullscreen()
            }
            
            if (elem.msRequestFullscreen) {
                return elem.msRequestFullscreen()
            }
        }

        const openFullscreen = document.querySelector('#open-fullscreen')
        const main = document.querySelector('main')

        openFullscreen.addEventListener('click', () => {
            fullscreen(main)
        })
    </script>

    <style>
        main {
            background: none;
            box-shadow: none;
        }

        .notification {
            opacity: .6;
        }

        #open-fullscreen {
            position: fixed;
            top: 1rem;
            left: 1rem;
            background: var(--card-background);
            height: 35px;
            aspect-ratio: 1;
            border-radius: 40%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
    </style>
</body>

</html>