{{ plug: 'head', title: 'Cardbox', links: [route('main') => 'Home'] }}

<div class="column">
    {{ each: $counts as $progress => $count }}
        <a href="{{ route('cardbox.level', level: $progress) }}"
            class="btn" style="background-color: {{ $colours[$progress] }}">
               {{ $progressLabel($progress).' ('.$count.')' }}
        </a>
    {{ each; }}
</div>
