{{ plug: 'head', title: 'Cardbox', links: [route('main') => 'Home'] }}

<div class="column">
    {{ each: $progresses as $progress => $count }}
        <a href="{{ route('cardbox.level', level: $progress) }}" class="btn">
            {{ $progressLabel($progress).' ('.$count.')' }}
        </a>
    {{ each; }}
</div>
